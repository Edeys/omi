# Omi self-host — commit-safe template for /opt/omi/.env (mode 600, NEVER commit real values)
# Copy to /opt/omi/.env on the VPS and fill placeholders. See backend/.env.template for full reference.
# Every var the backend expects is listed; keep diarizer/NLLB vars unset unless you self-host them.

# --- Universal-memory deployment controls (global incident/readiness switches) ---
MEMORY_ENABLED=on
MEMORY_MODE=off
MEMORY_CANONICAL_MAINTENANCE_ENABLED=false
MEMORY_V3_GET_ENABLED=false
ACCOUNT_CUTOVER_ENFORCEMENT=off

# --- Desktop conversation processing (self-host override) ---
# Upstream defers desktop-capture LLM enrichment for free-tier users until first
# open. Self-host has no billing gate — set false so captures enrich immediately.
OMI_DEFER_DESKTOP_PROCESSING=false
# Reasoning models behind OpenAI-compatible gateways ignore json_schema response
# format and break every .with_structured_output() call (conversation processing
# failed with BadRequestError). function_calling works with the same model.
OMI_STRUCTURED_METHOD=function_calling

# --- Storage buckets (GCS) — provision via selfhost/scripts/provision-buckets.sh ---
# Names below must stay in sync with what backend/utils/other/storage.py:82-90 reads.
BUCKET_PRIVATE_CLOUD_SYNC=omi-private-cloud-sync
BUCKET_SPEECH_PROFILES=omi-speech-profiles
BUCKET_MEMORIES_RECORDINGS=omi-memories-recordings
BUCKET_POSTPROCESSING=omi-postprocessing
BUCKET_TEMPORAL_SYNC_LOCAL=omi-temporal-sync-local
BUCKET_PLUGINS_LOGOS=omi-plugins-logos
BUCKET_APP_THUMBNAILS=omi-app-thumbnails
BUCKET_CHAT_FILES=omi-chat-files
# BUCKET_BACKUPS removed: dead var — no backend code reads it (grep 0 callers).

# --- Firebase / GCP ---
# Service account JSON is mounted at /secrets/firebase-service-account.json (600) via docker-compose volume.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-service-account.json
# Keep empty when using GOOGLE_APPLICATION_CREDENTIALS file; set only if you prefer inline JSON.
SERVICE_ACCOUNT_JSON=
FIREBASE_API_KEY=<firebase-web-api-key>
FIREBASE_AUTH_DOMAIN=<firebase-auth-domain>
FIREBASE_PROJECT_ID=<firebase-project-id>

# --- Redis (Docker network) ---
REDIS_DB_HOST=redis
REDIS_DB_PORT=6379
REDIS_DB_PASSWORD=

# --- LLM (OpenAI-compatible gateway; value below = what actually runs on the VPS) ---
# Task 1 audit: backend hardcodes api.openai.com for 'openai' provider; providers.py now reads OPENAI_BASE_URL
# (fallback OPENROUTER_BASE_URL) so the openai provider can reach the gateway.
# Changing these must be mirrored in AGENTS.md (fork section) — they must never drift.
OPENAI_API_KEY=<gateway-key>
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENROUTER_BASE_URL=https://9router.xuanloi.me/v1

# --- STT (Deepgram self-hosted — wire verified at utils/stt/streaming.py) ---
# STT_ENGINE: 'offline' = SOTA Vietnamese 30M model + Silero VAD segmentation
# (simulated streaming — finals at utterance boundaries, matches the backend's
# interim_results=False). 'streaming' = multilingual zipformer, true word-level
# streaming but weaker Vietnamese accuracy.
STT_ENGINE=offline
DEEPGRAM_API_KEY=
DEEPGRAM_SELF_HOSTED_ENABLED=true
DEEPGRAM_SELF_HOSTED_URL=http://stt-adapter:8092
MODULATE_API_KEY=

# --- Pinecone / Vector ---
# Leave PINECONE_* empty and keep LOCAL_VECTOR_ENABLED=true to use the embedded
# SQLite+numpy store (backend/database/local_vector_index.py) — no external
# service needed; data lives in the vector_data compose volume.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
LOCAL_VECTOR_ENABLED=true
LOCAL_VECTOR_DB_PATH=/data/vectors/omi-vectors.sqlite3

# --- Auth / Security ---
ENCRYPTION_SECRET=<openssl-rand-hex-32>
ADMIN_KEY=<openssl-rand-hex-16>
ADMIN_KEY_AUTH_ENABLED=true
BYOK_FINGERPRINT_PEPPER=
CORS_ALLOWED_ORIGINS=

# --- OAuth (Google Desktop app client) ---
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Base URLs ---
BASE_API_URL=https://omi-api.xuanloi.me
API_BASE_URL=https://omi-api.xuanloi.me
HOSTED_PUSHER_API_URL=http://pusher:8080

# --- Telemetry (blank = disabled) ---
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://app.posthog.com
ELEVENLABS_API_KEY=
PERPLEXITY_API_KEY=

# --- Twilio (Phone Calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# --- Stripe (blank = degraded, Plan/Usage without billing) ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Other integrations (keep blank unless you use them) ---
GITHUB_TOKEN=
HUME_API_KEY=
HUME_CALLBACK_URL=
TYPESENSE_HOST=
TYPESENSE_HOST_PORT=
TYPESENSE_API_KEY=
RAPID_API_HOST=
RAPID_API_KEY=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- LangSmith Tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omi-backend-chat
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
OMI_LANGSMITH_AGENTIC_PROMPT_NAME=omi-agentic-system
OMI_LANGSMITH_PROMPT_CACHE_TTL_SECONDS=300

# --- omi-apps (integration apps service) ---
# Primary LLM is OpenAI-compatible; falls back to OPENAI_BASE_URL/OPENAI_API_KEY/OMI_MAIN_MODEL when unset.
OMI_APPS_REDIS_URL=redis://redis:6379/2
OMI_APPS_LLM_TIMEOUT=75
OMI_APPS_LLM_BASE_URL=
OMI_APPS_LLM_API_KEY=
OMI_APPS_LLM_MODEL=
OMI_APPS_FALLBACK_LLM_BASE_URL=
OMI_APPS_FALLBACK_LLM_API_KEY=
OMI_APPS_FALLBACK_LLM_MODEL=
OMI_APPS_STT_ENABLED=false
OMI_APPS_STT_WS_URL=ws://stt-adapter:8092
OMI_APPS_MEMORY_DIR=/data/memory
OMI_APPS_FORWARD_URL=
OMI_APPS_AUDIO_DIR=/data/audio

# --- Notes ---
# - For the .env on VPS: replace every <...> placeholder with real values (see Task 2 outputs for Firebase/9Router/OAuth).
# - Generate ENCRYPTION_SECRET with: openssl rand -hex 32
# - Generate ADMIN_KEY with: openssl rand -hex 16
# - GOOGLE_APPLICATION_CREDENTIALS must point to /secrets/firebase-service-account.json inside the container.
